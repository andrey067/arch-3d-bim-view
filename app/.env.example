# --- Postgres ---
POSTGRES_USER=arch3dar
POSTGRES_PASSWORD=arch3dar_secret
POSTGRES_DB=arch3dar
DATABASE_URL=Host=postgres;Port=5432;Database=arch3dar;Username=arch3dar;Password=arch3dar_secret

# --- Local file storage (shared volume backend + converter) ---
DATA_ROOT=/data

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
# HTTPS required for AR on real devices (Quick Look / Scene Viewer)
PUBLIC_BASE_URL=https://localhost
CORS_ALLOWED_ORIGINS=https://localhost
MAX_UPLOAD_MB=100
MAX_IFC_MB=100
IFC_CONVERSION_TIMEOUT_S=120
SKP_CONVERSION_TIMEOUT_S=180
CONVERSION_TIMEOUT_S=120
# Tabletop AR preview: longest axis in meters (0.5 = ~50 cm miniature on a table)
AR_MAX_EXTENT_M=0.5
CONVERTER_URL=http://converter:8080

# --- Frontend ---
VITE_API_BASE_URL=https://localhost
