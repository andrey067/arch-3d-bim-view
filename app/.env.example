# --- Postgres ---
POSTGRES_USER=arch3dar
POSTGRES_PASSWORD=arch3dar_secret
POSTGRES_DB=arch3dar
DATABASE_URL=Host=postgres;Port=5432;Database=arch3dar;Username=arch3dar;Password=arch3dar_secret

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_IFC=ifc-files
MINIO_BUCKET_GLB=glb-files
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_BUCKET_QRCODES=qrcodes
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_PRESIGN_TTL_SECONDS=600

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_IFC_MB=100
CONVERSION_TIMEOUT_S=300
CONVERTER_URL=http://converter:8080

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:5000
